<p id="notice"><%= notice %></p>

<h1>Offers</h1>

<table class="table table-hover">
  <thead>
    <tr>
      <th>Shop</th>
      <th>Date</th>
      <th>Title</th>
      <th>Scheme</th>
      <th>Stop show</th>
      <th>Layout</th>
      <th>Required checkout</th>
      <th>Has discount</th>
      <th>Discount code</th>
      <th>General block rule</th>
      <th>To checkout</th>
      <th>Auto add</th>
      <th>Status</th>
      <th>Text</th>
      <th>Atc</th>
      <th>Close</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @offers.each do |offer| %>
      <tr>
        <td><%= offer.shop_id %></td>
        <td><%= offer.date %></td>
        <td><%= offer.title %></td>
        <td><%= offer.scheme %></td>
        <td><%= offer.stop_show %></td>
        <td><%= offer.layout %></td>
        <td><%= offer.required_checkout %></td>
        <td><%= offer.has_discount %></td>
        <td><%= offer.discount_code %></td>
        <td><%= offer.general_block_rule %></td>
        <td><%= offer.to_checkout %></td>
        <td><%= offer.auto_add %></td>
        <td><%= offer.status %></td>
        <td><%= offer.text %></td>
        <td><%= offer.atc %></td>
        <td><%= offer.close %></td>
        <td><%= link_to 'Show', "#{offer}?#{@params}" %></td>
        <td><%= link_to 'Edit', "#{edit_offer_path(offer)}?#{@params}" %></td>
        <td><%= link_to 'Destroy', "#{offer}?#{@params}", method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Offer', "#{new_offer_path}?#{@params}" %>
