<p id="notice"><%= notice %></p>

<div class="row">
  <div class="col-sm-1"></div>
  <div class="col-sm-10">
    <div class="d-flex align-items-center justify-content-between mb-2">
      <div>
        <h1>Offers</h1>
      </div>
      <div>
        <%= link_to 'New Offer', "#{new_offer_path}?#{@params}", class: "btn btn-primary" %>
      </div>
    </div>
    <div class="bg-white rounded border shadow px-3">

      <table class="table table-hover">
        <thead>
          <tr>
            <th>Shop</th>
            <th>Title</th>
            <th colspan="3"></th>
          </tr>
        </thead>

        <tbody>
          <% @offers.each do |offer| %>
            <tr>
              <td><%= offer.shop_id %></td>
              <td><%= offer.title %></td>
              <td><%= link_to 'Show', "#{offer}?#{@params}" %></td>
              <td><%= link_to 'Edit', "#{edit_offer_path(offer)}?#{@params}" %></td>
              <td><%= link_to 'Destroy', "#{offer}?#{@params}", method: :delete, data: { confirm: 'Are you sure?' } %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="col-sm-1"></div>
  </div>
