<p id="notice"><%= notice %></p>

<h1>Features</h1>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Description</th>
      <th>Shop</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @features.each do |feature| %>
      <tr>
        <td><%= feature.name %></td>
        <td><%= feature.description %></td>
        <td><%= feature.shop_id %></td>
        <td><%= link_to 'Show', "#{feature}?#{@params}" %></td>
        <td><%= link_to 'Edit', "#{edit_feature_path(feature)}?#{@params}" %></td>
        <td><%= link_to 'Destroy', "#{feature}?#{@params}", method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Feature', "#{new_feature_path}?#{@params}" %>
