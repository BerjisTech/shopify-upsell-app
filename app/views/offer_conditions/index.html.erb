<p id="notice"><%= notice %></p>

<h1>Offer Conditions</h1>

<table class="table table-hover">
  <thead>
    <tr>
      <th>Offer</th>
      <th>Block</th>
      <th>Condition</th>
      <th>Quantity</th>
      <th>Level</th>
      <th>Content</th>
      <th>Product</th>
      <th>Variant</th>
      <th>Amount</th>
      <th>Country</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @offer_conditions.each do |offer_condition| %>
      <tr>
        <td><%= offer_condition.offer_id %></td>
        <td><%= offer_condition.block_id %></td>
        <td><%= offer_condition.condition_id %></td>
        <td><%= offer_condition.quantity %></td>
        <td><%= offer_condition.level %></td>
        <td><%= offer_condition.content %></td>
        <td><%= offer_condition.product_id %></td>
        <td><%= offer_condition.variant_id %></td>
        <td><%= offer_condition.amount %></td>
        <td><%= offer_condition.country %></td>
        <td><%= link_to 'Show', "#{offer_condition}?#{@params}" %></td>
        <td><%= link_to 'Edit', "#{edit_offer_condition_path(offer_condition)}?#{@params}" %></td>
        <td><%= link_to 'Destroy', "#{offer_condition}?#{@params}", method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Offer Condition', "#{new_offer_condition_path}?#{@params}" %>
