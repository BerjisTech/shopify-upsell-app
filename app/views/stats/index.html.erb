<p id="notice"><%= notice %></p>

<h1>Stats</h1>

<table>
  <thead>
    <tr>
      <th>Date</th>
      <th>Shop</th>
      <th>Offer</th>
      <th>Product</th>
      <th>Variant</th>
      <th>Quantity</th>
      <th>Ip</th>
      <th>Country</th>
      <th>Type</th>
      <th>Action</th>
      <th>Page</th>
      <th>Position on page</th>
      <th>Device</th>
      <th>Browser</th>
      <th>Cart items</th>
      <th>Price</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @stats.each do |stat| %>
      <tr>
        <td><%= stat.date %></td>
        <td><%= stat.shop_id %></td>
        <td><%= stat.offer_id %></td>
        <td><%= stat.product %></td>
        <td><%= stat.variant %></td>
        <td><%= stat.quantity %></td>
        <td><%= stat.ip %></td>
        <td><%= stat.country %></td>
        <td><%= stat.type %></td>
        <td><%= stat.action %></td>
        <td><%= stat.page %></td>
        <td><%= stat.position_on_page %></td>
        <td><%= stat.device %></td>
        <td><%= stat.browser %></td>
        <td><%= stat.cart_items %></td>
        <td><%= stat.price %></td>
        <td><%= link_to 'Show', stat %></td>
        <td><%= link_to 'Edit', edit_stat_path(stat) %></td>
        <td><%= link_to 'Destroy', stat, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Stat', "#{new_stat_path}?#{@params}" %>
