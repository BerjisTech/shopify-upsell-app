<%= form_with(model: offer_setting) do |form| %>
  <% if offer_setting.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(offer_setting.errors.count, "error") %> prohibited this offer_setting from being saved:</h2>

      <ul>
        <% offer_setting.errors.each do |error| %>
