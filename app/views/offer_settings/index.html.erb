<p id="notice"><%= notice %></p>

<h1>Offer Settings</h1>

<table>
  <thead>
    <tr>
      <th>Offer</th>
      <th>Button color</th>
      <th>Button font</th>
      <th>Button border</th>
      <th>Button font size</th>
      <th>Button margin top</th>
      <th>Button margin bottom</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @offer_settings.each do |offer_setting| %>
      <tr>
        <td><%= offer_setting.offer_id %></td>
        <td><%= offer_setting.button_color %></td>
        <td><%= offer_setting.button_font %></td>
        <td><%= offer_setting.button_border %></td>
        <td><%= offer_setting.button_font_size %></td>
        <td><%= offer_setting.button_margin_top %></td>
        <td><%= offer_setting.button_margin_bottom %></td>
        <td><%= link_to 'Show', offer_setting %></td>
        <td><%= link_to 'Edit', edit_offer_setting_path(offer_setting) %></td>
        <td><%= link_to 'Destroy', offer_setting, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Offer Setting', new_offer_setting_path %>
