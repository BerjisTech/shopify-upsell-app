<p id="notice"><%= notice %></p>

<h1>Offer Products</h1>

<table>
  <thead>
    <tr>
      <th>Offer</th>
      <th>Shop</th>
      <th>Text</th>
      <th>Atc</th>
      <th>Show title</th>
      <th>Show price</th>
      <th>Show image</th>
      <th>Variant price</th>
      <th>Compare price</th>
      <th>Linked</th>
      <th>Quantity select</th>
      <th>Ab test</th>
      <th>Ab text</th>
      <th>Ab atc</th>
      <th>Replacement product</th>
      <th>Replacement variant</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @offer_products.each do |offer_product| %>
      <tr>
        <td><%= offer_product.offer_id %></td>
        <td><%= offer_product.shop_id %></td>
        <td><%= offer_product.text %></td>
        <td><%= offer_product.atc %></td>
        <td><%= offer_product.show_title %></td>
        <td><%= offer_product.show_price %></td>
        <td><%= offer_product.show_image %></td>
        <td><%= offer_product.variant_price %></td>
        <td><%= offer_product.compare_price %></td>
        <td><%= offer_product.linked %></td>
        <td><%= offer_product.quantity_select %></td>
        <td><%= offer_product.ab_test %></td>
        <td><%= offer_product.ab_text %></td>
        <td><%= offer_product.ab_atc %></td>
        <td><%= offer_product.replacement_product %></td>
        <td><%= offer_product.replacement_variant %></td>
        <td><%= link_to 'Show', offer_product %></td>
        <td><%= link_to 'Edit', edit_offer_product_path(offer_product) %></td>
        <td><%= link_to 'Destroy', offer_product, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Offer Product', new_offer_product_path %>
