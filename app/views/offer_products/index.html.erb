<p id="notice"><%= notice %></p>

<h1>Offer Products</h1>

<table>
  <thead>
    <tr>
      <th>Product</th>
      <th>Name</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @offer_products.each do |offer_product| %>
      <tr>
        <td><%= offer_product.product_id %></td>
        <td><%= offer_product.name %></td>
        <td><%= link_to 'Show', offer_product %></td>
        <td><%= link_to 'Edit', edit_offer_product_path(offer_product) %></td>
        <td><%= link_to 'Destroy', offer_product, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Offer Product', new_offer_product_path %>
