<p id="notice"><%= notice %></p>

<h1>Settings</h1>

<table>
  <thead>
    <tr>
      <th>Shop</th>
      <th>Cart location</th>
      <th>Cart position</th>
      <th>Drawer location</th>
      <th>Drawer position</th>
      <th>Refresh state</th>
      <th>Drawer refresh</th>
      <th>Layout bg</th>
      <th>Layout color</th>
      <th>Layout font</th>
      <th>Layout size</th>
      <th>Layout mt</th>
      <th>Layout mb</th>
      <th>Offer radius</th>
      <th>Offer bs</th>
      <th>Offer bc</th>
      <th>Offer border</th>
      <th>Button bg</th>
      <th>Button color</th>
      <th>Button font</th>
      <th>Button size</th>
      <th>Button mt</th>
      <th>Button mb</th>
      <th>Button radius</th>
      <th>Button bs</th>
      <th>Button bc</th>
      <th>Button border</th>
      <th>Image size</th>
      <th>Image radius</th>
      <th>Image bs</th>
      <th>Image bc</th>
      <th>Image border</th>
      <th>Text color</th>
      <th>Text font</th>
      <th>Text size</th>
      <th>Title color</th>
      <th>Title font</th>
      <th>Title size</th>
      <th>Price color</th>
      <th>C price color</th>
      <th>Price font</th>
      <th>Price size</th>
      <th>C price size</th>
      <th>Override</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @settings.each do |setting| %>
      <tr>
        <td><%= setting.shop_id %></td>
        <td><%= setting.cart_location %></td>
        <td><%= setting.cart_position %></td>
        <td><%= setting.drawer_location %></td>
        <td><%= setting.drawer_position %></td>
        <td><%= setting.refresh_state %></td>
        <td><%= setting.drawer_refresh %></td>
        <td><%= setting.layout_bg %></td>
        <td><%= setting.layout_color %></td>
        <td><%= setting.layout_font %></td>
        <td><%= setting.layout_size %></td>
        <td><%= setting.layout_mt %></td>
        <td><%= setting.layout_mb %></td>
        <td><%= setting.offer_radius %></td>
        <td><%= setting.offer_bs %></td>
        <td><%= setting.offer_bc %></td>
        <td><%= setting.offer_border %></td>
        <td><%= setting.button_bg %></td>
        <td><%= setting.button_color %></td>
        <td><%= setting.button_font %></td>
        <td><%= setting.button_size %></td>
        <td><%= setting.button_mt %></td>
        <td><%= setting.button_mb %></td>
        <td><%= setting.button_radius %></td>
        <td><%= setting.button_bs %></td>
        <td><%= setting.button_bc %></td>
        <td><%= setting.button_border %></td>
        <td><%= setting.image_size %></td>
        <td><%= setting.image_radius %></td>
        <td><%= setting.image_bs %></td>
        <td><%= setting.image_bc %></td>
        <td><%= setting.image_border %></td>
        <td><%= setting.text_color %></td>
        <td><%= setting.text_font %></td>
        <td><%= setting.text_size %></td>
        <td><%= setting.title_color %></td>
        <td><%= setting.title_font %></td>
        <td><%= setting.title_size %></td>
        <td><%= setting.price_color %></td>
        <td><%= setting.c_price_color %></td>
        <td><%= setting.price_font %></td>
        <td><%= setting.price_size %></td>
        <td><%= setting.c_price_size %></td>
        <td><%= setting.override %></td>
        <td><%= link_to 'Show', setting %></td>
        <td><%= link_to 'Edit', edit_setting_path(setting) %></td>
        <td><%= link_to 'Destroy', setting, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Setting', new_setting_path %>
