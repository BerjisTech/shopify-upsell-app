<%= form_with(model: custom_field) do |form| %>
  <% if custom_field.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(custom_field.errors.count, "error") %> prohibited this custom_field from being saved:</h2>

      <ul>
        <% custom_field.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :offer_id %>
    <%= form.number_field :offer_id %>
  </div>

  <div class="field">
    <%= form.label :product_id %>
    <%= form.number_field :product_id %>
  </div>

  <div class="field">
    <%= form.label :field_type %>
    <%= form.text_field :field_type %>
  </div>

  <div class="field">
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div class="field">
    <%= form.label :placeholder %>
    <%= form.text_field :placeholder %>
  </div>

  <div class="field">
    <%= form.label :price %>
    <%= form.text_field :price %>
  </div>

  <div class="field">
    <%= form.label :required %>
    <%= form.text_field :required %>
  </div>

  <div class="actions">
    <%= form.submit %>
  </div>
<% end %>
