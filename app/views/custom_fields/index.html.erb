<p id="notice"><%= notice %></p>

<h1>Custom Fields</h1>

<table>
  <thead>
    <tr>
      <th>Offer</th>
      <th>Product</th>
      <th>Field type</th>
      <th>Name</th>
      <th>Placeholder</th>
      <th>Price</th>
      <th>Required</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @custom_fields.each do |custom_field| %>
      <tr>
        <td><%= custom_field.offer_id %></td>
        <td><%= custom_field.product_id %></td>
        <td><%= custom_field.field_type %></td>
        <td><%= custom_field.name %></td>
        <td><%= custom_field.placeholder %></td>
        <td><%= custom_field.price %></td>
        <td><%= custom_field.required %></td>
        <td><%= link_to 'Show', "#{custom_field}?#{@params}" %></td>
        <td><%= link_to 'Edit', "#{edit_custom_field_path(custom_field)}?#{@params}" %></td>
        <td><%= link_to 'Destroy', "#{custom_field}?#{@params}", method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Custom Field', "#{new_custom_field_path}?#{@params}" %>
