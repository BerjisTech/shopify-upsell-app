<p id="notice"><%= notice %></p>

<h1>Conditions</h1>

<table class="table table-hover">
  <thead>
    <tr>
      <th>Name</th>
      <th>Description</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @conditions.each do |condition| %>
      <tr>
        <td><%= condition.name %></td>
        <td><%= condition.description %></td>
        <td><%= link_to 'Show', "#{condition}?#{@params}" %></td>
        <td><%= link_to 'Edit', "#{edit_condition_path(condition)}?#{@params}" %></td>
        <td><%= link_to 'Destroy', "#{condition}?#{@params}", method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Condition', "#{new_condition_path}?#{@params}" %>
