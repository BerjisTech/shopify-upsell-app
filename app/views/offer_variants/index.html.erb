<p id="notice"><%= notice %></p>

<h1>Offer Variants</h1>

<table class="table table-hover">
  <thead>
    <tr>
      <th>Offer</th>
      <th>Product</th>
      <th>Variant</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @offer_variants.each do |offer_variant| %>
      <tr>
        <td><%= offer_variant.offer_id %></td>
        <td><%= offer_variant.product %></td>
        <td><%= offer_variant.variant %></td>
        <td><%= link_to 'Show', "#{offer_variant}?#{@params}" %></td>
        <td><%= link_to 'Edit', "#{edit_offer_variant_path(offer_variant)}?#{@params}" %></td>
        <td><%= link_to 'Destroy', "#{offer_variant}?#{@params}", method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Offer Variant', "#{new_offer_variant_path}?#{@params}" %>
